# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/people_unified?retryWrites=true&w=majority
MONGODB_DB=people_unified

# Razorpay Test Mode (server-only values must never be committed)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=replace_in_Vercel_only
RAZORPAY_WEBHOOK_SECRET=replace_in_Vercel_only

# Existing PostgreSQL routes remain available during the staged migration
DATABASE_URL=postgresql://user:password@host:5432/people_unified
